{
  "expo": {
    "name": "Al-Meera Ahadiya",
    "slug": "abdul-rafi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/ahadiya-logo.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "lk.almeera.ahadiya",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/ahadiya-logo-adaptive.png"
      },
      "package": "lk.almeera.ahadiya",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "534060d4-0d02-4570-b485-53256f68dc8b"
      }
    },
    "owner": "abdulrafi"
  }
}
